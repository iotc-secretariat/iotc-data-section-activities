FlexouilleLaTableMonDalon
FlexouilleLaTableMonDalon <- function(DataSet) {
DataSet |>
data.table::data.table() |>
flextable::flextable() |>
flextable::font(part = "all", fontname = "Calibri") |>
flextable::fontsize(part = "all", size = 9) |>
flextable::align(part = "header", align = "center") |>
flextable::bold(part = "header") |>
flextable::bg(part = "header", bg = "gray") |>
flextable::autofit()
}
render("rmd/00_DOCX_HTML.Rmd",
output_dir = "./outputs/",
output_file = document
)
FlexouilleLaTableMonDalon <- function(DataSet) {
FT <- DataSet |>
data.table::as.data.table() |>
flextable::flextable() |>
flextable::font(part = "all", fontname = "Calibri") |>
flextable::fontsize(part = "all", size = 9) |>
flextable::align(part = "header", align = "center") |>
flextable::bold(part = "header") |>
flextable::bg(part = "header", bg = "gray") |>
flextable::border_inner(
border = officer::fp_border(color = "black", width = 0.5)
) |>
flextable::border_outer(
border = officer::fp_border(color = "black", width = 2)
) |>
flextable::colformat_double(digits = 0) |>
flextable::autofit()
FT
}
render("rmd/00_DOCX_HTML.Rmd",
output_dir = "./outputs/",
output_file = document
)
